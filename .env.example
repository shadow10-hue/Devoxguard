# Copy to .env and fill in real values before `docker compose -f
# docker-compose.prod.yml up -d`. Never commit the populated .env file
# (already gitignored).

# --- api-demo ---------------------------------------------------------
NODE_ENV=production
PORT=3000

# Required in production — the app refuses to boot without it (see
# packages/api-demo/src/config/env.ts). Generate with: openssl rand -hex 32
DEVOXGUARD_API_KEY=

# Service DNS names as defined in docker-compose.prod.yml — leave these
# as-is unless you renamed the services.
DEVOXGUARD_MONGO_URI=mongodb://mongo:27017
DEVOXGUARD_MONGO_DB=devoxguard
DEVOXGUARD_ES_NODE=http://elasticsearch:9200

# The demo app's OWN datastore (backs the deliberately NoSQLi-vulnerable
# /account/login endpoint). Same MongoDB instance as above by default, but
# a separate database so app data and engine findings don't mix.
APP_MONGO_URI=mongodb://mongo:27017
APP_MONGO_DB=api-demo

# Optional — enables Redis-backed (shared, horizontally-scalable)
# anomaly-detector state instead of in-memory-per-process. Leave unset
# to keep the original in-memory behavior; nothing else needs to change.
# Also backs shared IP auto-containment when DEVOXGUARD_AUTO_CONTAIN=true.
DEVOXGUARD_REDIS_URI=redis://redis:6379

# Optional incident response (docs/incident-response.md). Leave unset/false
# to keep both off. DEVOXGUARD_ALERT_WEBHOOK: a Slack-compatible JSON webhook
# alerted on blocked high-severity findings. DEVOXGUARD_AUTO_CONTAIN: set to
# true to temporarily ban IPs that repeatedly trip the injection detectors.
# DEVOXGUARD_ALERT_WEBHOOK=
DEVOXGUARD_AUTO_CONTAIN=false

# --- dashboard (nginx reverse proxy) -----------------------------------
# Where nginx forwards /devoxguard/api/* to. Leave as-is unless you
# renamed the api-demo service.
DEVOXGUARD_API_UPSTREAM=http://api-demo:3000

# --- caddy (TLS edge) ---------------------------------------------------
# A domain whose DNS A record already points at this VM's public IP, and
# an email Let's Encrypt can use for expiry notices.
DOMAIN=devoxguard.example.com
ACME_EMAIL=you@example.com

# Basic-auth credentials protecting the dashboard AND the internal
# DevoxGuard API at the TLS edge. REQUIRED — without a hash Caddy refuses
# to start, because the dashboard's nginx injects the real API key
# server-side for every request that reaches it, so an unauthenticated
# edge would expose the internal API (findings, rules, captured request
# metadata) to anyone on the internet.
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-password'
DASHBOARD_AUTH_USER=admin
DASHBOARD_AUTH_HASH=
