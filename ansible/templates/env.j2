NODE_ENV=production
PORT=3000
DEVOXGUARD_API_KEY={{ devoxguard_api_key }}
DEVOXGUARD_MONGO_URI=mongodb://mongo:27017
DEVOXGUARD_MONGO_DB=devoxguard
DEVOXGUARD_ES_NODE=http://elasticsearch:9200
DEVOXGUARD_REDIS_URI=redis://redis:6379
APP_MONGO_URI=mongodb://mongo:27017
APP_MONGO_DB=api-demo
DEVOXGUARD_API_UPSTREAM=http://api-demo:3000
DEVOXGUARD_AUTO_CONTAIN={{ devoxguard_auto_contain | default('true') }}
{% if devoxguard_alert_webhook is defined %}
DEVOXGUARD_ALERT_WEBHOOK={{ devoxguard_alert_webhook }}
{% endif %}
DOMAIN={{ devoxguard_domain }}
ACME_EMAIL={{ devoxguard_acme_email }}
DASHBOARD_AUTH_USER={{ devoxguard_dashboard_auth_user | default('admin') }}
DASHBOARD_AUTH_HASH={{ devoxguard_dashboard_auth_hash }}
