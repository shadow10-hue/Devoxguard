{
  "name": "devoxguard",
  "version": "0.1.0",
  "private": true,
  "description": "DevoxGuard monorepo: proprietary application-security engine (NestJS) + vulnerable demo API + Vue dashboard",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w packages/engine",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "jest -c jest.config.js",
    "generate-logs": "ts-node scripts/generate-logs.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"packages/api-demo/{src,test,scripts}/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,vue}": "eslint --fix"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
